# ---------------------------------------------------------------------------
# Restaurant Vision Analytics — example environment file
# Copy to `.env` and adjust. NEVER commit your real `.env`.
# No camera credentials, API keys, or secrets belong in version control.
# ---------------------------------------------------------------------------

# Application environment: development | production | test
APP_ENV=development

# Database connection string.
# Default is local SQLite (file-based, zero-config, privacy-friendly).
# For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rva
DATABASE_URL=sqlite:///./data/rva.db

# Demo mode: generate synthetic, anonymous customer-flow data without a camera.
# Recommended for first run, screenshots, and CI.
ENABLE_DEMO_MODE=true

# Demo intensity: expected arrivals per simulated minute (busier venues = higher).
# Visual/demo only; has no effect with a real camera source.
DEMO_ARRIVAL_RATE=16

# Demo RNG seed for reproducible runs (leave blank for varied output).
DEMO_SEED=7

# Privacy hard-default: raw frame/video persistence is OFF.
# This toolkit is designed to never store raw imagery by default.
# Enabling this is an explicit, audited operator decision.
ENABLE_RAW_FRAME_STORAGE=false

# Data retention window for aggregated, anonymous metrics (in days).
# Older snapshots are pruned by the retention service.
DATA_RETENTION_DAYS=7

# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional camera source for real-camera mode (RTSP URL, device index, or file).
# Leave blank to stay in demo mode. Do NOT embed credentials in committed files.
# Example (kept out of git): CAMERA_SOURCE=rtsp://CAMERA_HOST:554/stream
CAMERA_SOURCE=

# Ephemeral tracker: how long (seconds) an anonymous track ID may live without
# a new detection before it expires. Keep short — IDs are never persisted.
TRACK_TTL_SECONDS=5

# WebSocket live-update interval (seconds) used by demo mode.
LIVE_UPDATE_INTERVAL_SECONDS=2
